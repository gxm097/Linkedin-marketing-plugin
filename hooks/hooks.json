{
  "description": "Reminds you when the weekly LinkedIn carousel is due, and when a mention check is due.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--script", "${CLAUDE_PLUGIN_ROOT}/hooks/nudge.py", "carousel"],
            "timeout": 30,
            "statusMessage": "Checking if the weekly carousel is due"
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--script", "${CLAUDE_PLUGIN_ROOT}/hooks/nudge.py", "mentions"],
            "timeout": 30,
            "statusMessage": "Checking if a mention check is due"
          }
        ]
      }
    ]
  }
}
