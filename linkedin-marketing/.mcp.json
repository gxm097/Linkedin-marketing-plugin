{
  "mcpServers": {
    "canva": {
      "type": "http",
      "url": "https://api.canva.com/connect/v1/mcp"
    },
    "linkedin": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/gxm097/linkedin-mcp-server@v4.28.0-comment.1",
        "mcp-server-linkedin",
        "--transport",
        "stdio"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
