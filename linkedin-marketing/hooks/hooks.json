{
  "description": "Reminds you when the weekly LinkedIn carousel is due.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/weekly-nudge.sh"],
            "timeout": 10,
            "statusMessage": "Checking if the weekly carousel is due"
          }
        ]
      }
    ]
  }
}
